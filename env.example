# --- Bắt buộc ---
DISCORD_TOKEN=dán_token_bot_vào_đây

# --- Tuỳ chọn (đã có giá trị mặc định hợp lý) ---
TIMEZONE=Asia/Ho_Chi_Minh
# Báo trước bao nhiêu phút; 0 = đúng giờ bắt đầu. Ví dụ "30,10,0"
NOTIFY_OFFSETS=15,0
# Giờ gửi bản tin "lịch 24 giờ tới" mỗi ngày (theo TIMEZONE), -1 = tắt
DAILY_DIGEST_HOUR=7
# Cập nhật lịch từ nguồn mỗi bao nhiêu phút / lấy trước bao nhiêu ngày
REFRESH_MINUTES=120
DAYS_AHEAD=14
# F1/F2/F3: báo cả buổi tập tự do?
NOTIFY_PRACTICE=false
# Đặt ID server của bạn để lệnh slash hiện ngay (khi phát triển); bỏ trống = đồng bộ toàn cầu (có thể mất ~1 giờ)
DEV_GUILD_ID=
# Key TheSportsDB (V.League). "123" là key miễn phí
TSDB_API_KEY=123

# Chấm trạng thái ở avatar: online | idle (🌙 Chờ) | dnd | invisible
BOT_STATUS=idle
# Dòng chữ ngay dưới tên bot (để trống = ẩn)
BOT_ACTIVITY=Đang cập nhật giải đấu...
# Dòng phụ khi bấm vào hồ sơ bot (để trống = không dùng)
BOT_ACTIVITY_DETAIL=
# playing | watching | listening | competing | custom (custom bị Discord tự thêm 🤔)
BOT_ACTIVITY_TYPE=playing

# --- Ghi đè nguồn dữ liệu nếu slug/ID mặc định sai (SOURCE_<KEY>) ---
# SOURCE_ACLT=afc.cup
# SOURCE_VL2=<idLeague trên TheSportsDB>

# --- Chạy trên Render Web Service (gói Free: filesystem tạm, mất file khi restart) ---
# Render tự đặt PORT và RENDER_EXTERNAL_URL -> tự bật Flask keep-alive + self-ping.
# Chạy local muốn thử: KEEP_ALIVE=true và PORT=8080
# Self-ping mỗi N phút (Render ngủ sau 15 phút không có request đến)
SELF_PING_MINUTES=5
# Cấu hình qua biến môi trường để KHÔNG mất khi Render restart:
CHANNEL_ID=            # chuột phải kênh -> Copy Channel ID (bật Developer Mode)
ROLE_ID=               # (tuỳ chọn) role được nhắc tên
SEED_LEAGUES=all       # hoặc: epl,laliga,bundesliga,seriea,c1,c2,c3,acle,aclt,vl1,vl2,f1,f2,f3
SEED_DIGEST=true

# Khi Discord chặn IP host (429/1015): chờ N phút rồi thử lại, mỗi lần gấp đôi (tối đa 30 phút)
LOGIN_RETRY_MINUTES=5
